# Quality gate floors enforced by CI (.github/workflows/ci.yml).
#
# The scheduled Quality Ratchet (.github/workflows/quality-ratchet.yml) only
# ever raises these values via pull request; it never lowers them. Lowering a
# floor requires a deliberate human change reviewed like any other PR.
#
# Clippy has no budget here: CI denies all clippy warnings outright.
COVERAGE_MIN_LINES=65
